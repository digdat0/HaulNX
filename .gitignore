# build output
/build/
/build-public/
*.nro

# desktop/ as a whole stays untracked (see build-public.ps1), but these two
# generated outputs get a belt-and-suspenders ignore in case of a stray `git
# add -A` from the repo root
/desktop/HaulNX-AppUtility-public.exe
/desktop/src-tauri/target-public/
*.elf
*.nacp
*.lst
*.map

# The wiki pages live in their own repo (HaulNX.wiki.git), which is what GitHub
# serves. Keeping a working copy here is convenient; committing it into this
# repo would fork the same pages into two histories.
/wiki/

# local scratch (icon work, backups)
/settings icons/
/icon_prev.jpg
/icon_full_src.jpg
/make_icon.py
/haulNX_icon.png
/haulNX_icon_edited.png
/haulNX_icon_new.png
/other console icons/
